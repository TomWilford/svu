{
  "name": "tomwilford/svu",
  "description": "Application template for Slim projects with a UI",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "fig/http-message-util": "^1.1",
    "jimtools/basic-auth": "^1.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "php-di/php-di": "^7.1",
    "selective/basepath": "^2.4",
    "sinemacula/http-primitives-php": "^2.0",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4",
    "tomwilford/slim-sqids": "^1.0",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2",
    "selective/test-traits": "^4.3",
    "tomwilford/doctrine-test-traits": "^1.0"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public/"
  }
}
