{
  "name": "tomwilford/svu",
  "description": "Application template for Slim projects",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
      "psr-4": {
          "App\\Tests\\": "tests/"
      }
  },
  "require": {
    "php": "^8.5",
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "jimtools/basic-auth": "^1.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "php-di/php-di": "^7.1",
    "selective/basepath": "^2.4",
    "sinemacula/http-primitives-php": "^2.0",
    "slim/slim": "^4.15",
    "slim/twig-view": "^3.4",
    "twig/twig": "^3.30"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13",
    "selective/test-traits": "^4.3",
    "squizlabs/php_codesniffer": "^4.0",
    "tomwilford/doctrine-test-traits": "^1.0"
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public/",
    "cs:check": "php-cs-fixer fix --dry-run --format=txt --verbose --config=.cs.php --ansi",
    "cs:fix": "php-cs-fixer fix --config=.cs.php --ansi --verbose",
    "sniffer:check": "phpcs --standard=phpcs.xml",
    "sniffer:fix": "phpcbf --standard=phpcs.xml",
    "stan": "phpstan analyse -c phpstan.neon --no-progress --ansi",
    "test": "phpunit --configuration phpunit.xml --do-not-cache-result --colors=always --display-warnings --display-deprecations --no-coverage",
    "test:all": [
        "@sniffer:check",
        "@stan",
        "@test:coverage"
    ],
    "test:coverage": [
        "@putenv XDEBUG_MODE=coverage",
        "phpunit --configuration phpunit.xml --do-not-cache-result --colors=always --display-warnings --display-deprecations --coverage-clover build/coverage/clover.xml --coverage-html build/coverage --coverage-text"
    ]
  }
}
